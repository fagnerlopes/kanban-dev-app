# Kanban Dev Flow — environment variables (reference only, no secrets)
# Local dev: copy to .env and fill in real values (.env is git-ignored).
# Deploy: these are provided by the Kamal config / GitHub Secrets (see .kamal/ and config/).

# Port the HTTP server listens on. 8080 in local dev, 80 in the container.
PORT=8080

# Postgres connection string. Locally, point at the dev container.
DATABASE_URL="postgres://postgres:***@localhost:5432/postgres?sslmode=disable"

# Public origin of the app (used to derive absolute URLs / OAuth callbacks).
BASE_URL=http://localhost:5173

# Set to 1 to enable development-only routes (POST /api/dev/login).
# MUST NEVER be set in production.
DEV_MODE=1

# Sentry DSN for error reporting. Empty disables reporting.
# In deploy, this comes from the SENTRY_DSN GitHub Secret.
SENTRY_DSN=
